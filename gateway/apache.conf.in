# Omics Canvas gateway (port @VIZHUB_PORT@): one address for every module.
# GENERATED by ./vizhubctl configure from gateway/apache.conf.in and deploy/site.env — edit those, not this file.
#   /                 -> /hub/ (visualization hub landing page)
#   /hub/ /spatial/ /single-cell/ /crispr/   -> hub backend   127.0.0.1:@VIZHUB_HUB_PORT@ (hub/server.py)
#   /genome-canvas/   -> Genome Canvas                        127.0.0.1:@VIZHUB_CANVAS_PORT@ (genome-canvas/server.py)
@jupyter@#   everything else   -> JupyterLab (/lab, /api, kernels...)  127.0.0.1:@VIZHUB_JUPYTER_PORT@
# Run by vizhub-gateway.service (systemd user unit); manage with ../vizhubctl.
ServerRoot "@VIZHUB_DIR@/gateway"
DefaultRuntimeDir "@VIZHUB_DIR@/gateway/run"
PidFile "@VIZHUB_DIR@/gateway/run/apache.pid"

Listen @VIZHUB_LISTEN@:@VIZHUB_PORT@
ServerName @VIZHUB_SERVER_NAME@
ServerAdmin @VIZHUB_USER@@localhost

LoadModule mpm_event_module @VIZHUB_APACHE_MODULES@/mod_mpm_event.so
LoadModule authn_core_module @VIZHUB_APACHE_MODULES@/mod_authn_core.so
LoadModule authz_core_module @VIZHUB_APACHE_MODULES@/mod_authz_core.so
LoadModule headers_module @VIZHUB_APACHE_MODULES@/mod_headers.so
LoadModule proxy_module @VIZHUB_APACHE_MODULES@/mod_proxy.so
LoadModule proxy_http_module @VIZHUB_APACHE_MODULES@/mod_proxy_http.so
LoadModule proxy_wstunnel_module @VIZHUB_APACHE_MODULES@/mod_proxy_wstunnel.so
LoadModule rewrite_module @VIZHUB_APACHE_MODULES@/mod_rewrite.so
LoadModule alias_module @VIZHUB_APACHE_MODULES@/mod_alias.so

ErrorLog "@VIZHUB_DIR@/gateway/logs/error.log"
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "@VIZHUB_DIR@/gateway/logs/access.log" combined
LogLevel warn

KeepAlive On
MaxKeepAliveRequests 200
KeepAliveTimeout 5
ProxyRequests Off
ProxyPreserveHost On
ProxyTimeout 600

RewriteEngine On
# Landing page and slashless entry points (mod_rewrite runs before ProxyPass)
RewriteRule ^/$ /hub/ [R=302,L]
RewriteRule ^/(hub|spatial|single-cell|crispr|genome-canvas)$ /$1/ [R=302,L]

# Visualization hub: hub page, spatial / single-cell viewers, CRISPR explorer and their API
ProxyPass        /hub/         http://127.0.0.1:@VIZHUB_HUB_PORT@/hub/
ProxyPassReverse /hub/         http://127.0.0.1:@VIZHUB_HUB_PORT@/hub/
ProxyPass        /spatial/     http://127.0.0.1:@VIZHUB_HUB_PORT@/spatial/
ProxyPassReverse /spatial/     http://127.0.0.1:@VIZHUB_HUB_PORT@/spatial/
ProxyPass        /single-cell/ http://127.0.0.1:@VIZHUB_HUB_PORT@/single-cell/
ProxyPassReverse /single-cell/ http://127.0.0.1:@VIZHUB_HUB_PORT@/single-cell/
ProxyPass        /crispr/      http://127.0.0.1:@VIZHUB_HUB_PORT@/crispr/
ProxyPassReverse /crispr/      http://127.0.0.1:@VIZHUB_HUB_PORT@/crispr/
<LocationMatch "^/(hub|spatial|single-cell|crispr)/">
    RequestHeader unset X-Remote-User
</LocationMatch>

# Genome Canvas uses an application-level, password-free workspace selector.
ProxyPass        /genome-canvas/ http://127.0.0.1:@VIZHUB_CANVAS_PORT@/ nocanon
ProxyPassReverse /genome-canvas/ http://127.0.0.1:@VIZHUB_CANVAS_PORT@/
<Location "/genome-canvas/">
    RequestHeader unset X-Remote-User
    RequestHeader set X-Forwarded-Prefix "/genome-canvas"
</Location>

@jupyter@# Preserve Jupyter kernel and terminal WebSocket upgrades.
@jupyter@RewriteCond %{HTTP:Upgrade} =websocket [NC]
@jupyter@RewriteRule ^/(.*)$ ws://127.0.0.1:@VIZHUB_JUPYTER_PORT@/$1 [P,L]
@jupyter@
@jupyter@# Everything else remains the existing JupyterLab site.
@jupyter@ProxyPass        / http://127.0.0.1:@VIZHUB_JUPYTER_PORT@/ nocanon
@jupyter@ProxyPassReverse / http://127.0.0.1:@VIZHUB_JUPYTER_PORT@/
