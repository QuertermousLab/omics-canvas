# Colon-separated directories visible in the server file browser.
GENOME_DATA_ROOTS=/srv/genome-tracks:/mnt/sequencing

# The backend should normally remain private behind a reverse proxy.
GENOME_CANVAS_HOST=127.0.0.1
GENOME_CANVAS_PORT=8000

# Displayed by genome-canvasctl. Change to your LAN hostname or address.
GENOME_CANVAS_PUBLIC_URL=http://genome-canvas.example.internal/
