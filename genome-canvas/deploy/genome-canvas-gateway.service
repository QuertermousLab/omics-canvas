[Unit]
Description=Port 8892 gateway for JupyterLab and Genome Canvas
Wants=network-online.target jupyter-lab.service genome-canvas.service
After=network-online.target jupyter-lab.service genome-canvas.service

[Service]
Type=simple
ExecStart=/usr/sbin/apache2 -f %h/baldar/IGV/deploy/apache/genome-canvas-gateway.conf -DFOREGROUND
ExecReload=/usr/sbin/apache2 -f %h/baldar/IGV/deploy/apache/genome-canvas-gateway.conf -k graceful
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=default.target
