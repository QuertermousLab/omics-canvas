[Unit]
Description=Genome Canvas local genome browser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/baldar/IGV
ExecStart=%h/baldar/IGV/start.sh --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=GENOME_CANVAS_REFERENCE_DIR=%h/.cache/genome-canvas/references

[Install]
WantedBy=default.target
