# Omics Canvas server settings, read by ./vizhubctl (configure, install, status).
# `./vizhubctl configure` writes deploy/site.env (local, not committed) from these defaults and your answers, then
# generates gateway/apache.conf, the systemd units (deploy/generated/) and the matching keys of hub/config.json.
# The values below are THOR's (the lab server), so a fresh checkout there needs no changes.

# The gateway: one address for every module. 0.0.0.0 = every network interface; 127.0.0.1 = this machine only,
# for servers that are reached through SSH port forwarding (ssh -L) and should not be open to the network.
VIZHUB_LISTEN=0.0.0.0
VIZHUB_PORT=8892
# The address people open: shown on the pages and in copied links. Behind port forwarding use what they type in
# the browser, e.g. http://localhost:8892.
VIZHUB_PUBLIC_URL=http://171.65.68.140:8892
VIZHUB_SERVER_NAME=171.65.68.140

# Internal ports (127.0.0.1 only): the hub backend, Genome Canvas, and an existing JupyterLab served at the
# gateway's other paths (/lab); leave VIZHUB_JUPYTER_PORT empty when the server has none.
VIZHUB_HUB_PORT=8893
VIZHUB_CANVAS_PORT=8000
VIZHUB_JUPYTER_PORT=8891
VIZHUB_JUPYTER_BIN=/usr/local/bin/jupyter-lab

# For people outside the server's network: the SSH host (and port) they log in to for port forwarding;
# `./vizhubctl status` prints the ssh -L command and the Mac app settings. Empty: no port forwarding hint.
VIZHUB_SSH_HOST=171.65.68.140
VIZHUB_SSH_PORT=22

# Folders the data pages browse (colon-separated); used when hub/config.json is created.
VIZHUB_DATA_ROOTS=/nfs

# Apache (Debian / Ubuntu paths).
VIZHUB_APACHE_BIN=/usr/sbin/apache2
VIZHUB_APACHE_MODULES=/usr/lib/apache2/modules
