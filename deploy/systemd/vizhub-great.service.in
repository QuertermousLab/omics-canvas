# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Canvas GREAT: region set enrichment (GREAT 4.0.4, rGREAT and batch interfaces)
Wants=network-online.target
After=network-online.target genome-canvas.service

[Service]
Type=simple
WorkingDirectory=@VIZHUB_DIR@/great
ExecStart=/usr/bin/env python3 @VIZHUB_DIR@/great/server.py --host 127.0.0.1 --port @VIZHUB_GREAT_PORT@ --canvas http://127.0.0.1:@VIZHUB_CANVAS_PORT@
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Omics Canvas sign-in (VIZHUB_SIGN_IN in deploy/site.env): the sessions it checks; empty = no sign-in
Environment=OMICS_CANVAS_AUTH=@VIZHUB_AUTH_STATE@

[Install]
WantedBy=default.target
