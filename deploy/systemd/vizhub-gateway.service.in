# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Canvas gateway (port @VIZHUB_PORT@): hub, Genome Canvas@jupyter-label@
Wants=network-online.target @jupyter-unit@genome-canvas.service vizhub-hub.service
After=network-online.target @jupyter-unit@genome-canvas.service vizhub-hub.service

[Service]
Type=simple
ExecStart=@VIZHUB_APACHE_BIN@ -f @VIZHUB_DIR@/gateway/apache.conf -DFOREGROUND
ExecReload=@VIZHUB_APACHE_BIN@ -f @VIZHUB_DIR@/gateway/apache.conf -k graceful
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=default.target
# genome-canvasctl (in genome-canvas/) still manages the gateway under its old name
Alias=genome-canvas-gateway.service
