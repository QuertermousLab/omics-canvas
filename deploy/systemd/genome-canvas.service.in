# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Genome Canvas local genome browser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@VIZHUB_DIR@/genome-canvas
ExecStart=@VIZHUB_DIR@/genome-canvas/start.sh --host 127.0.0.1 --port @VIZHUB_CANVAS_PORT@
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=GENOME_CANVAS_REFERENCE_DIR=%h/.cache/genome-canvas/references

[Install]
WantedBy=default.target
