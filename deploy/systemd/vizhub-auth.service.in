# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Canvas sign-in and admin pages (/auth/, /admin/; 127.0.0.1:@VIZHUB_AUTH_PORT@)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@VIZHUB_DIR@/auth
ExecStart=/usr/bin/env python3 @VIZHUB_DIR@/auth/server.py --host 127.0.0.1 --port @VIZHUB_AUTH_PORT@ --state @VIZHUB_DIR@/state/auth
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
