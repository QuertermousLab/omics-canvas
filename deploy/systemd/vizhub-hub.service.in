# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Canvas hub backend (home page, spatial / single-cell viewers, CRISPR explorer; 127.0.0.1:@VIZHUB_HUB_PORT@)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@VIZHUB_DIR@/hub
ExecStart=@VIZHUB_DIR@/hub/venv/bin/python server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Omics Canvas sign-in (VIZHUB_SIGN_IN in deploy/site.env): the sessions it checks; empty = no sign-in
Environment=OMICS_CANVAS_AUTH=@VIZHUB_AUTH_STATE@

[Install]
WantedBy=default.target
