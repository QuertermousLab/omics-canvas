[Unit]
Description=THOR visualization hub backend (hub page, spatial/single-cell viewers, CRISPR explorer; 127.0.0.1:8893)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/baldar/vizhub/hub
ExecStart=%h/baldar/vizhub/hub/venv/bin/python server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
